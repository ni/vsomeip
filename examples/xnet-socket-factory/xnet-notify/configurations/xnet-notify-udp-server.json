{
  "unicast": "10.0.0.2",
  "network": "xnet-notify-server",
  "logging": {
    "level": "debug",
    "console": "false",
    "file": {
      "enable": "true",
      "path": "./vsomeip.log"
    }
  },
  "applications": [
    {
      "name": "xnet-notify-server",
      "id": "0x1212"
    }
  ],
  "services": [
    {
      "service": "0x1234",
      "instance": "0x5678",
      "unreliable": "30509",
      "events": [
        {
          "event": "0x8778",
          "is_field": "true"
        }
      ],
      "eventgroups": [
        {
          "eventgroup": "0x4465",
          "events": [ "0x8778" ]
        }
      ]
    }
  ],
  "routing": "xnet-notify-server",
  "service-discovery": {
    "enable": "true",
    "multicast": "224.224.224.245",
    "port": "30490",
    "protocol": "udp",
    "initial_delay_min": "10",
    "initial_delay_max": "100",
    "repetitions_base_delay": "200",
    "repetitions_max": "3",
    "ttl": "3",
    "cyclic_offer_delay": "2000",
    "request_response_delay": "1500"
  }
}
